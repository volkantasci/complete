<odoo>
    <!-- The Gantt view of the attendances: one row per employee, the day as default range.
         Only the options below are set; a later module adds the form view or the plan
         option by inheriting this view. The two-week precision entry names a scale the
         view does not know and is ignored. -->
    <record id="hr_attendance_view_gantt" model="ir.ui.view">
        <field name="name">attendance timeline by employee</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <gantt js_class="attendance_gantt" string="Days"
                   date_start="check_in" date_stop="check_out" color="wet_color"
                   default_group_by="employee_id" groups_limit="20"
                   default_range="day" default_scale="day"
                   precision="{'day': 'hour:quarter', 'week': 'day:quarter', 'month': 'day:half', '2weeks': 'day:half'}"
                   display_unavailability="1" progress_bar="employee_id"/>
        </field>
    </record>

    <!-- The management action opens the Gantt view first, grouped by employee. -->
    <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
        <field name="view_mode">gantt,list,form</field>
        <field name="context">{'search_default_employee': 1}</field>
    </record>

    <record id="hr_attendance_action_view_gantt" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="hr_attendance_view_gantt"/>
        <field name="act_window_id" ref="hr_attendance.hr_attendance_action"/>
    </record>
</odoo>
