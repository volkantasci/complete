<templates xml:space="preserve">
    <!-- What an employee row header shows before the name: the avatar (R4), called with `row` in scope. -->
    <!-- What an employee row header shows before the name, called with `row` in scope: only the
         thumbnail of 002a's lead; the avatar sits in the identity box of the title line below. -->
    <t t-name="hr_gantt.EmployeeRowLead"><t t-call="web_gantt.TimelineRowLead"/></t>

    <!-- The employee variant's grid: in an employee row's title line the avatar and the name share
         one box (the identity box, R4), before the hours label. -->
    <t t-name="hr_gantt.EmployeeTimelineRenderer" t-inherit="web_gantt.TimelineRenderer" t-inherit-mode="primary">
        <xpath expr="//span[hasclass('o_tl_row_name')]" position="replace">
            <t t-set="employee" t-value="this.employeeOf(row)"/>
            <span t-if="employee" class="o_hrg_identity">
                <img class="o_hrg_avatar" t-att-src="this.avatarUrl(employee)" t-att-data-tooltip="employee.name" title="" alt="" t-on-click.stop="(ev) => this.onAvatarClick(ev, employee)"/>
                <span class="o_tl_row_name"><span class="o_tl_row_label" t-att-class="this.nameClass(row)" t-out="row.row.name"/></span>
            </span>
            <span t-else="" class="o_tl_row_name"><span class="o_tl_row_label" t-att-class="this.nameClass(row)" t-out="row.row.name"/></span>
        </xpath>
    </t>
</templates>
