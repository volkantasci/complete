<templates xml:space="preserve">
    <!-- The leave popover (R2 to R6): header, body (the request's form) and footer. -->
    <t t-name="hr_holidays_gantt.TimeOffLeavePopover">
        <div t-att-class="this.rootClass" t-on-keydown.capture="this.onKeydownCapture">
            <div class="o_hhg_pop_header d-flex align-items-center flex-shrink-0">
                <div class="o_hhg_pop_title flex-grow-1 text-truncate" t-out="this.title"/>
                <button type="button" class="o_hhg_pop_expand btn btn-link p-0 border-0" title="Expand" aria-label="Expand" t-on-click="this.onExpand">
                    <i class="oi" data-icon="expand_content"/>
                </button>
                <button type="button" class="o_hhg_pop_close btn btn-link p-0 border-0" title="Close" aria-label="Close" t-on-click.stop="this.props.close">
                    <i class="oi" data-icon="close"/>
                </button>
            </div>
            <div class="o_hhg_pop_content">
                <View t-props="this.viewProps"/>
            </div>
            <div class="o_hhg_pop_footer d-flex flex-shrink-0"><t t-call="hr_holidays_gantt.TimeOffPopoverFooter"/></div>
        </div>
    </t>

    <!-- R6: the footer's buttons, left to right, absent where not shown; the last one sits at the
         right end (Discard with a pending change, else Delete). -->
    <t t-name="hr_holidays_gantt.TimeOffPopoverFooter">
        <t t-foreach="this.footerButtons" t-as="button" t-key="button.name">
            <button type="button" t-att-class="`o_hhg_pop_button o_hhg_pop_${button.name} btn ${button.style}`" t-att-name="button.name" t-on-click="() => this.onFooterButton(button.name)">
                <i class="oi me-1" t-att-data-icon="button.icon"/><t t-out="button.label"/>
            </button>
        </t>
    </t>
</templates>
