<templates xml:space="preserve">
    <!-- The grid of the employee variant, with the class of the time-off views on its box, so that
         the stylesheet can restyle the hours label (R16) without touching other views. -->
    <t t-name="hr_holidays_gantt.TimeOffRenderer" t-inherit="hr_gantt.EmployeeTimelineRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_tl_box')]" position="attributes">
            <attribute name="class" add="o_hhg_time_off" separator=" "/>
        </xpath>
    </t>
</templates>
