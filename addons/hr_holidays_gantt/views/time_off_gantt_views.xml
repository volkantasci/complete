<odoo>
    <!-- The Gantt view of the time off requests: one row per employee, a month as default range.
         The precision keys name the drawn scales (the quarter is drawn on the month scale), so
         the month entry serves the quarter too. No popover: a later part adds it. -->
    <record id="hr_leave_gantt_view" model="ir.ui.view">
        <field name="name">time off requests timeline by employee</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <gantt js_class="hr_holidays_gantt_manager_hr_leave" string="Days"
                   date_start="request_date_hour_from" date_stop="request_date_hour_to"
                   color="color" default_group_by="employee_id" groups_limit="20"
                   default_range="month" scales="week,month,quarter"
                   precision="{'week': 'day:full', 'month': 'day:full'}"
                   decoration-danger="state == 'refuse'"
                   decoration-info="state in ('confirm', 'validate1')"
                   decoration-secondary="state == 'cancel'"
                   display_unavailability="1" progress_bar="employee_id"
                   total_row="1" plan="0">
                <field name="state"/>
            </gantt>
        </field>
    </record>

    <!-- The Gantt view of the time-off report: read-only, the employee gives the colour. -->
    <record id="hhg_report_gantt_view" model="ir.ui.view">
        <field name="name">time off report timeline by employee</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="arch" type="xml">
            <gantt js_class="hr_holidays_report_gantt" string="Time Off"
                   date_start="request_date_hour_from" date_stop="request_date_hour_to"
                   color="employee_id" default_group_by="employee_id" groups_limit="20"
                   default_range="month"
                   precision="{'month': 'day:full'}"
                   display_unavailability="1" total_row="1" sample="1"
                   create="0" edit="0" delete="0"/>
        </field>
    </record>
</odoo>
