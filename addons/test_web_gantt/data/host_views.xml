<odoo>
    <record id="host_view_h13" model="ir.ui.view">
        <field name="name">H13 Search view with archived filter</field>
        <field name="model">test.web.gantt.pill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_contact" string="Contact" context="{'group_by': 'x_contact'}"/>
                    <filter name="group_tags" string="Tags" context="{'group_by': 'x_tags'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="host_view_h1" model="ir.ui.view">
        <field name="name">H1 Main</field>
        <field name="model">test.web.gantt.pill</field>
        <field name="arch" type="xml">
            <gantt string="Pills" date_start="date_start" date_stop="date_stop" default_range="week" color="x_color" progress="x_progress" decoration-danger="x_flagged" decoration-info="x_done" total_row="1" thumbnails="{'x_contact': 'avatar_128'}"><field name="x_flagged"/><field name="x_done"/></gantt>
        </field>
    </record>

    <record id="host_action_h1" model="ir.actions.act_window">
        <field name="name">H1 Main</field>
        <field name="res_model">test.web.gantt.pill</field>
        <field name="view_mode">gantt,list,form</field>
        <field name="view_id" ref="host_view_h1"/>
        <field name="search_view_id" ref="host_view_h13"/>
        <field name="context">{}</field>
    </record>

