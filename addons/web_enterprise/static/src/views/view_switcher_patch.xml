<templates xml:space="preserve">

  <t t-name="web_enterprise.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
    <!-- slice 001b animates the highlight with these values -->
    <xpath position="attributes" expr="//nav[hasclass('o_cp_switch_buttons')]">
      <attribute name="t-att-data-cws-views">this.cwsViewCount</attribute>
      <attribute name="t-att-data-cws-active">this.cwsActiveIndex</attribute>
      <attribute name="t-att-data-cws-from">this.cwsFromIndex</attribute>
      <attribute name="t-att-style">'--cws-switch-from: ' + this.cwsFromIndex + '; --cws-switch-to: ' + this.cwsActiveIndex</attribute>
    </xpath>
  </t>

</templates>
