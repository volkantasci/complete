<odoo>
    <!-- Priority below the default (16) so that, when the mail module adds its
         notification field to the same group, the Theme field comes first. -->
    <record model="ir.ui.view" id="view_users_form_simple_modif_color_scheme">
        <field name="name">res.users.preferences.form.color.scheme</field>
        <field name="priority">8</field>
        <field name="inherit_id" eval="ref('base.view_users_form_simple_modif')"/>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="color_scheme" string="Theme" widget="radio" options="{'horizontal': true}" readonly="0"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_users_form_color_scheme">
        <field name="name">res.users.form.color.scheme</field>
        <field name="priority">8</field>
        <field name="inherit_id" eval="ref('base.view_users_form')"/>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="color_scheme" string="Theme" widget="radio" options="{'horizontal': true}" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
