<odoo>
    <template id="webclient_bootstrap_browser_chrome" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="t-att-content">request.env['ir.http']._cws_browser_chrome_colour(color_scheme)</attribute>
        </xpath>
        <!-- the back-end page declares its scheme to the browser (R46) -->
        <xpath expr="//t[@t-call='web.layout']" position="before">
            <t t-set="cws_declared_scheme" t-value="'dark' if color_scheme == 'dark' else 'light'"/>
        </xpath>
    </template>

    <!-- every page built on the base layout declares light unless it sets a scheme,
         which covers the login page and the other public pages (R46) -->
    <template id="layout_declared_scheme" inherit_id="web.layout">
        <xpath expr="//meta[@http-equiv='X-UA-Compatible']" position="after">
            <meta name="color-scheme" t-att-content="'dark' if cws_declared_scheme == 'dark' else 'light'"/>
        </xpath>
    </template>
    <!-- the offline page paints itself dark from the remembered scheme (cookie), so it
         declares dark then; the script covers a copy that the service worker cached -->
    <template id="webclient_offline_declared_scheme" inherit_id="web.webclient_offline">
        <xpath expr="//t[@t-call='web.layout']" position="before">
            <t t-set="cws_declared_scheme" t-value="'dark' if request.cookies.get('color_scheme') == 'dark' else 'light'"/>
        </xpath>
        <xpath expr="//t[@t-set='head']" position="inside">
            <script type="text/javascript">
                if (document.cookie.split(';').map((c) =&gt; c.trim()).includes('color_scheme=dark')) {
                    document.documentElement.style.colorScheme = 'dark';
                    const meta = document.querySelector('meta[name="color-scheme"]');
                    if (meta) {
                        meta.setAttribute('content', 'dark');
                    }
                }
            </script>
        </xpath>
    </template>
</odoo>
