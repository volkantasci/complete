<templates xml:space="preserve">
    <!-- The drawing handles of a pill (002c R11), called inside the pill loop of the renderer
         with `pill` and `row` in scope. They lie beside the pill, not in it: the body clips. -->
    <t t-name="web_gantt.TimelineConnectHandles">
        <t t-set="connectHandles" t-value="this.connectHandlesOf(pill, row)"/>
        <div t-if="connectHandles.length" class="o_tl_connect" t-att-class="this.connectClass(pill, row)" t-att-style="pill.style" t-att-data-pill-id="pill.id">
            <div t-foreach="connectHandles" t-as="handle" t-key="handle.edge" class="o_tl_connect_handle" t-att-class="`o_tl_connect_${handle.edge}`" t-att-data-edge="handle.edge" t-att-data-pill-key="this.keyOfPill(pill, row)" t-on-pointerdown="(ev) => this.onConnectPointerDown(ev, pill, row, handle.edge)" t-on-mouseenter="() => this.onPillEnter(pill, row)" t-on-mouseleave="(ev) => this.onPillLeave(pill, row, ev)">
                <span class="o_tl_connect_halo"/>
                <span class="o_tl_connect_corner"/>
                <span class="o_tl_connect_dot"/>
            </div>
        </div>
    </t>
</templates>
