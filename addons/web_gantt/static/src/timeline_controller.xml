<templates xml:space="preserve">
    <t t-name="web_gantt.TimelineButtons">
        <div class="d-flex o_tl_buttons">
            <button t-if="this.canCreate" type="button" class="btn btn-primary o_tl_button_add" data-hotkey="c" t-on-click="this.onNew">New</button>
        </div>
    </t>

    <t t-name="web_gantt.TimelineController">
        <div class="o_timeline_view d-flex flex-column" t-ref="this.rootRef" t-att-class="(this.props.className || '') + (this.ui.isSmall ? ' o_tl_phone' : '')">
            <Layout className="(this.data.isSample ? 'o_view_sample_data ' : '') + 'd-flex flex-column'" display="this.props.display">
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu/>
                </t>
                <t t-set-slot="control-panel-buttons">
                    <t t-call="web_gantt.TimelineButtons"/>
                </t>
                <t t-set-slot="control-panel-actions">
                    <SearchBar toggler="this.searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="this.searchBarToggler.component" t-props="this.searchBarToggler.props"/>
                </t>
                <t t-call="web_gantt.TimelineControls"/>
                <t t-component="this.props.Renderer" model="this.model" archInfo="this.props.archInfo" noContentHelp="this.props.info.noContentHelp"/>
            </Layout>
        </div>
    </t>

    <t t-name="web_gantt.TimelineControls">
        <div class="o_tl_controls d-flex flex-wrap align-items-center" t-att-class="{ 'o_tl_controls_phone': this.ui.isSmall }">
            <t t-if="this.ui.isSmall">
                <div class="o_tl_line d-flex align-items-center w-100">
                    <t t-call="web_gantt.TimelineStepButtons"/>
                    <t t-call="web_gantt.TimelineRangeMenu"/>
                </div>
                <div class="o_tl_separator w-100" role="separator"/>
                <div class="o_tl_line d-flex align-items-center w-100">
                    <t t-call="web_gantt.TimelineTodayButton"/>
                    <Dropdown menuClass="'o_tl_gear_menu'">
                        <button type="button" class="btn btn-secondary o_tl_gear ms-auto" title="Menu" aria-label="Menu"><i class="oi oi-filled" data-icon="settings"/></button>
                        <t t-set-slot="content">
                            <DropdownItem class="'o_tl_gear_display'" onSelected="() => this.toggleDisplayMode()">
                                <i class="oi oi-fw me-2" t-att-data-icon="this.displayModeIcon"/>
                                <span t-out="this.displayModeLabel"/>
                            </DropdownItem>
                            <t t-if="this.hasGroupRows">
                                <div class="dropdown-divider" role="separator"/>
                                <DropdownItem class="'o_tl_gear_collapse_all'" onSelected="() => this.toggleCollapseAll()">
                                    <i class="oi oi-fw me-2" t-att-data-icon="this.collapseAllIcon"/>
                                    <span t-out="this.collapseAllTitle"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                </div>
            </t>
            <t t-else="">
                <t t-call="web_gantt.TimelineStepButtons"/>
                <t t-call="web_gantt.TimelineRangeMenu"/>
                <t t-call="web_gantt.TimelineTodayButton"/>
                <button type="button" class="btn btn-secondary o_tl_display_mode" t-att-title="this.displayModeTitle" t-on-click="this.toggleDisplayMode">
                    <i class="oi" t-att-data-icon="this.displayModeIcon"/>
                </button>
                <button type="button" class="btn btn-secondary o_tl_collapse_all" t-att-class="{ invisible: !this.hasGroupRows }" t-att-title="this.collapseAllTitle" t-on-click="this.toggleCollapseAll">
                    <i class="oi" t-att-data-icon="this.collapseAllIcon"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="web_gantt.TimelineStepButtons">
        <div class="btn-group o_tl_step_buttons">
            <button type="button" class="btn btn-secondary o_tl_previous" data-hotkey="p" title="Previous" aria-label="Previous" t-on-click="() => this.step(-1)"><i class="oi" data-icon="arrow_back"/></button>
            <button type="button" class="btn btn-secondary o_tl_next" data-hotkey="n" title="Next" aria-label="Next" t-on-click="() => this.step(1)"><i class="oi" data-icon="arrow_forward"/></button>
        </div>
    </t>

    <t t-name="web_gantt.TimelineTodayButton">
        <button type="button" class="btn btn-secondary o_tl_today" data-hotkey="t" title="Jump to today" t-on-click="this.goToday">Today</button>
    </t>

    <t t-name="web_gantt.TimelineRangeMenu">
        <Dropdown state="this.rangeMenu" menuClass="'o_tl_range_menu'">
            <button type="button" class="btn btn-secondary o_tl_range_button" data-hotkey="v">
                <t t-if="this.rangeLabel" t-out="this.rangeLabel"/>
                <t t-else="">
                    <span class="o_tl_range_start" t-out="this.formatDay(this.shownRange.start)"/>
                    <i class="oi o_tl_range_arrow" data-icon="arrow_forward"/>
                    <span class="o_tl_range_stop" t-out="this.formatDay(this.shownRange.stop)"/>
                </t>
                <i class="oi o_tl_range_caret" t-att-data-icon="this.rangeMenu.isOpen ? 'arrow_drop_up' : 'arrow_drop_down'"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem t-foreach="this.offeredKinds" t-as="item" t-key="item.kind"
                    class="`o_tl_range_item o_tl_range_${item.kind} ${item.isCurrent ? 'selected' : ''}`"
                    onSelected="() => this.setKind(item.kind)">
                    <span t-out="item.label"/>
                </DropdownItem>
                <div class="dropdown-divider" role="separator"/>
                <div class="o_tl_custom_line d-flex align-items-center gap-2">
                    <t t-if="this.ui.isSmall">
                        <button type="button" class="btn btn-secondary o_tl_custom_start_button" t-on-click="() => this.openDateDialog('start')" t-out="this.formatDay(this.custom.start)"/>
                        <i class="oi o_tl_custom_arrow" data-icon="arrow_forward"/>
                        <button type="button" class="btn btn-secondary o_tl_custom_stop_button" t-on-click="() => this.openDateDialog('stop')" t-out="this.formatDay(this.custom.stop)"/>
                    </t>
                    <t t-else="">
                        <span class="o_tl_custom_start" t-on-focusin="this.keepDateUnselected" t-on-click="this.keepDateUnselected">
                            <DateTimeInput type="'date'" value="this.custom.start"
                                onChange="(value) => this.onCustomDate('start', value)"
                                onApply="(value) => this.onCustomDate('start', value)"/>
                        </span>
                        <i class="oi o_tl_custom_arrow" data-icon="arrow_forward"/>
                        <span class="o_tl_custom_stop" t-on-focusin="this.keepDateUnselected" t-on-click="this.keepDateUnselected">
                            <DateTimeInput type="'date'" value="this.custom.stop"
                                onChange="(value) => this.onCustomDate('stop', value)"
                                onApply="(value) => this.onCustomDate('stop', value)"/>
                        </span>
                    </t>
                    <button type="button" class="btn btn-primary btn-sm o_tl_apply" t-on-click="this.applyCustom">Apply</button>
                </div>
            </t>
        </Dropdown>
    </t>

    <t t-name="web_gantt.TimelineDateDialog">
        <Dialog title="this.props.title" size="'sm'" footer="false" contentClass="'o_tl_date_dialog'">
            <DateTimePicker type="'date'" value="this.props.value" onSelect="(value) => this.onSelect(value)"/>
        </Dialog>
    </t>
</templates>
