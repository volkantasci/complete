<odoo>
    <!-- The Tracks button opens the timeline on the first moment and the range of the event;
         the two values are computed, not stored, and stay invisible in the form. -->
    <record id="event_event_view_form_track_gantt" model="ir.ui.view">
        <field name="name">event.event.form.track.gantt</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="website_event_track.event_event_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[field[@name='track_count']]" position="attributes">
                <attribute name="context">{'initialDate': track_plan_start, 'default_scale': track_plan_scale}</attribute>
            </xpath>
            <div name="button_box" position="inside">
                <field name="track_plan_start" invisible="1"/>
                <field name="track_plan_scale" invisible="1"/>
            </div>
        </field>
    </record>
</odoo>
